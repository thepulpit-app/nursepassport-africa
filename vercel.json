{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin.html"
    },
    {
      "source": "/((?!admin).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/check-trials",
      "schedule": "0 23 * * *"
    }
  ]
}